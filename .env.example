GEMINI_API_KEY=
BACKEND_URL=http://localhost:8000
SECRET_KEY=
DATABASE_URL=postgresql://postgres:password@localhost:5432/fickologen
ADMIN_USERNAMES=
KNOWLEDGE_KEY=

# Weekly program reminders by email (leave SMTP_HOST empty to turn them off)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Fickologen <noreply@example.com>
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
# Where the links in the email point (the Streamlit frontend)
APP_URL=http://localhost:8501
# Sunday hour (Swedish time) from which reminders go out
REMINDER_HOUR=18
# Set to off if a cron job calls POST /admin/reminders/send instead
REMINDER_SCHEDULER=on
